# ==============================================================================
# CUREXAL — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary Environment (local | staging | production)
CUREXAL_PRIMARY_ENV=local

# ------------------------------------------------------------------------------
# 1. NETWORKING, DOMAINS & PORTS
# ------------------------------------------------------------------------------
PORT=8080
CUREXAL_SERVER_PORT=8080
CUREXAL_SERVER_DOMAIN=curexal.space
COOKIE_DOMAIN=.curexal.space

# Frontend Application URLs
PUBLIC_APP_URL=https://curexal.space
PLATFORM_APP_URL=https://app.curexal.space
API_APP_URL=https://api.curexal.space

# ------------------------------------------------------------------------------
# 2. DURABLE DATABASE (PostgreSQL / NeonDB Serverless)
# ------------------------------------------------------------------------------
# Format: postgres://[user]:[password]@[endpoint].neon.tech/curexal?sslmode=require
CUREXAL_DB_DSN=postgres://postgres:postgres@localhost:5432/curexal?sslmode=disable
CUREXAL_DATABASE_HOST=localhost
CUREXAL_DATABASE_PORT=5432
CUREXAL_DATABASE_USER=postgres
CUREXAL_DATABASE_PASSWORD=postgres
CUREXAL_DATABASE_NAME=curexal
CUREXAL_DATABASE_SSL_MODE=disable

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (Cloudflare R2 / S3-Compatible Production Storage)
# ------------------------------------------------------------------------------
# Options: "local" (development fallback) | "s3" or "r2" (production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=./storage/documents

# Cloudflare R2 / S3 Production Parameters
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=curexal-documents
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://cdn.curexal.space

# ------------------------------------------------------------------------------
# 4. EPHEMERAL CACHE (In-Memory Go Cache / Optional Redis)
# ------------------------------------------------------------------------------
# Options: "memory" (zero-dependency native in-memory cache) | "redis"
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL=10m
# REDIS_ADDR=localhost:6379

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SESSION TOKENS
# ------------------------------------------------------------------------------
CUREXAL_AUTH_SECRET_KEY=replace-with-ultra-secure-256-bit-random-secret-key
CUREXAL_AUTH_JWT_COOKIE_NAME=jwt
CUREXAL_AUTH_REFRESH_COOKIE_NAME=refresh_token
CUREXAL_AUTH_COOKIE_DOMAIN=.curexal.space
CUREXAL_AUTH_COOKIE_PATH=/
CUREXAL_AUTH_COOKIE_SECURE=true
CUREXAL_AUTH_COOKIE_HTTPONLY=true
CUREXAL_AUTH_COOKIE_SAMESITE=Lax
CUREXAL_AUTH_LOCKOUT_DURATION=1m
CUREXAL_AUTH_ALLOW_TEST_HEADERS=false

# ------------------------------------------------------------------------------
# 6. INTEGRATIONS & TRANSACTIONAL EMAILS
# ------------------------------------------------------------------------------
CUREXAL_INTEGRATION_RESEND_API_KEY=
CUREXAL_INTEGRATION_EMAIL_FROM_NAME="Curexal Health"
CUREXAL_INTEGRATION_EMAIL_FROM_ADDRESS=noreply@contact.curexal.space
CUREXAL_INTEGRATION_EMAIL_LOGO_URL=https://cdn.curexal.space/email/full_logo.png
CUREXAL_INTEGRATION_EMAIL_APP_URL=https://curexal.space
