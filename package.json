{
  "name": "curexal-monorepo",
  "private": true,
  "description": "Curexal Health Operating System Monorepo",
  "workspaces": [
    "apps/web-public",
    "apps/web-platform"
  ],
  "scripts": {
    "build": "bun run --cwd apps/web-platform build && bun run --cwd apps/web-public build",
    "build:api": "cd apps/api && go build -ldflags=\"-w -s\" -o bin/curexal-backend ./cmd/CUREXAL",
    "build:platform": "bun run --cwd apps/web-platform build",
    "build:public": "bun run --cwd apps/web-public build",
    "start": "cd apps/api && ./bin/curexal-backend"
  }
}
