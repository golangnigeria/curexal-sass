{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@curexal/contracts": ["../../packages/contracts/src/index.ts"],
      "@curexal/utils": ["../../packages/utils/src/index.ts"],
      "@curexal/ui": ["../../packages/ui/src/index.ts"],
      "@curexal/design-system": ["../../packages/design-system/src/index.ts"],
      "@curexal/api-client": ["../../packages/api-client/src/index.ts"],
      "@curexal/auth": ["../../packages/auth/src/index.ts"],
      "@curexal/permissions": ["../../packages/permissions/src/index.ts"],
      "@curexal/tenant-context": ["../../packages/tenant-context/src/index.ts"],
      "@curexal/tenant-context/*": ["../../packages/tenant-context/src/*"],
      "@curexal/documents": ["../../packages/documents/src/index.ts"],
      "@curexal/patient": ["../../packages/patient/src/index.ts"],
      "@curexal/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
