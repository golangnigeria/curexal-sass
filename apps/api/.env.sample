CUREXAL_PRIMARY.ENV="local"

CUREXAL_SERVER.PORT="8080"
CUREXAL_SERVER.DOMAIN="localhost"
CUREXAL_SERVER.WORKSPACE_PORT="5003"
CUREXAL_SERVER.PORTAL_PORT="5001"
CUREXAL_SERVER.ADMIN_PORT="5002"
CUREXAL_SERVER.PUBLIC_PORT="5001"
CUREXAL_SERVER.READ_TIMEOUT="30"
CUREXAL_SERVER.WRITE_TIMEOUT="30"
CUREXAL_SERVER.IDLE_TIMEOUT="60"
CUREXAL_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:5001,http://localhost:5002,http://localhost:5003"

CUREXAL_DATABASE.HOST="localhost"
CUREXAL_DATABASE.PORT="5432"
CUREXAL_DATABASE.USER="postgres"
CUREXAL_DATABASE.PASSWORD=""
CUREXAL_DATABASE.NAME="CUREXAL"
CUREXAL_DATABASE.SSL_MODE="disable"
CUREXAL_DB_DSN="postgres://postgres:@localhost:5432/CUREXAL?sslmode=disable"
CUREXAL_DATABASE.MAX_OPEN_CONNS="25"
CUREXAL_DATABASE.MAX_IDLE_CONNS="25"
CUREXAL_DATABASE.CONN_MAX_LIFETIME="300"
CUREXAL_DATABASE.CONN_MAX_IDLE_TIME="300"

CUREXAL_AUTH.SECRET_KEY="secret"
CUREXAL_AUTH.COOKIE_DOMAIN="localhost"
CUREXAL_AUTH.REQUIRES_MFA="true"
CUREXAL_AUTH.PLATFORM_STAFF_ROLES="super_admin,super_support_agent,super_sales_staff,super_compliance_officer"

CUREXAL_INTEGRATION.RESEND_API_KEY=""

CUREXAL_REDIS.ADDRESS="127.0.0.1:6379"
CUREXAL_REDIS.PASSWORD=

# ============================================================================
# AWS CONFIGURATION
# ============================================================================

CUREXAL_AWS.REGION="us-east-1"
CUREXAL_AWS.ACCESS_KEY_ID="minioadmin"
CUREXAL_AWS.SECRET_ACCESS_KEY="minioadminpassword"
CUREXAL_AWS.UPLOAD_BUCKET="CUREXAL-bucket"
CUREXAL_AWS.ENDPOINT_URL="http://localhost:9000"



# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
CUREXAL_OBSERVABILITY.SERVICE_NAME="CUREXAL"
CUREXAL_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
CUREXAL_OBSERVABILITY.LOGGING.LEVEL="debug"
CUREXAL_OBSERVABILITY.LOGGING.FORMAT="console"
CUREXAL_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
CUREXAL_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CUREXAL_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
CUREXAL_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
CUREXAL_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
CUREXAL_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
CUREXAL_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
CUREXAL_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
CUREXAL_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"